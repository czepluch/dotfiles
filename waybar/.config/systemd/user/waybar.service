[Unit]
# Self-contained waybar unit that shadows the packaged /usr/lib version.
# Hyprland is launched without uwsm, so there is no systemd-managed
# graphical-session.target to bind to (the packaged unit's
# Requisite=graphical-session.target would block a standalone start).
# Started from hyprland.conf via: exec-once = systemctl --user start --no-block waybar.service
Description=Waybar (standalone; Hyprland launched without uwsm)
Documentation=https://github.com/Alexays/Waybar/wiki/
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
ExecStart=/usr/bin/waybar
ExecReload=/usr/bin/kill -SIGUSR2 $MAINPID
Restart=on-failure
RestartSec=1
