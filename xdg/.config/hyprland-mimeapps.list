[Default Applications]
# Read before mimeapps.list while XDG_CURRENT_DESKTOP is Hyprland. Apps and
# xdg-mime write their own changes to mimeapps.list, never to this file.

# Plain text and its subtypes (csv, source files without a handler of their own)
text/plain=nvim-ghostty.desktop
text/markdown=nvim-ghostty.desktop
text/csv=nvim-ghostty.desktop
text/x-source=nvim-ghostty.desktop

# Every image type imv declares
image/png=imv.desktop
image/x-png=imv.desktop
image/jpeg=imv.desktop
image/jpg=imv.desktop
image/pjpeg=imv.desktop
image/gif=imv.desktop
image/webp=imv.desktop
image/svg+xml=imv.desktop
image/bmp=imv.desktop
image/x-bmp=imv.desktop
image/tiff=imv.desktop
image/tiff-fx=imv.desktop
image/avif=imv.desktop
image/heif=imv.desktop
image/jxl=imv.desktop
image/qoi=imv.desktop
image/x-farbfeld=imv.desktop
