#!/usr/bin/env python3
# omarchy-import - Import an Omarchy theme as a palette (third producer,
# alongside theme-import and wallpaper-theme).
#
# Omarchy themes (MIT, basecamp/omarchy) define named colors in a colors.toml;
# this maps them onto our 22-key palette format and writes a normal tracked
# palette. The theme's primary background image is downloaded into
# ~/pics/wallpapers/ by default and wired up as the palette's wallpaper.
#
# Usage:
#   omarchy-import --list                    List built-in Omarchy themes
#   omarchy-import lumon                     Import a built-in theme
#   omarchy-import <git-url>                 Import a community theme repo
#   omarchy-import https://omarchythemes.com/themes/<name>
#                                            Resolve the repo from the page
#
# Options: --apply (theme-set afterwards), --no-wallpaper, --force
# (overwrite an existing palette), --dry-run (print, write nothing).

import argparse
import json
import re
import subprocess
import sys
import tempfile
import tomllib
import urllib.request
from pathlib import Path

THEMES_DIR = Path(__file__).resolve().parent.parent
PALETTES_DIR = THEMES_DIR / "palettes"
WALLPAPER_DIR = Path.home() / "pics" / "wallpapers"
UPSTREAM = "basecamp/omarchy"
MIN_BACKGROUND_BYTES = 100_000  # skip logos/icons in backgrounds/

IMAGE_EXT = {".jpg", ".jpeg", ".png", ".webp"}


def die(msg: str) -> None:
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(1)


def gh_api(path: str, raw: bool = False) -> bytes:
    cmd = ["gh", "api"]
    if raw:
        cmd += ["-H", "Accept: application/vnd.github.raw"]
    cmd.append(path)
    result = subprocess.run(cmd, capture_output=True)
    if result.returncode != 0:
        die(f"gh api {path} failed: {result.stderr.decode().strip()}")
    return result.stdout


def list_builtin() -> list[str]:
    entries = json.loads(gh_api(f"repos/{UPSTREAM}/contents/themes"))
    return sorted(e["name"] for e in entries if e["type"] == "dir")


def pick(colors: dict, *keys: str, required: bool = False, label: str = "") -> str | None:
    for k in keys:
        if k in colors:
            return colors[k]
    if required:
        die(f"theme is missing required color '{label or keys[0]}' "
            f"(tried: {', '.join(keys)})")
    return None


OUR_KEYS = ["accent", "cursor", "foreground", "background",
            "selection_foreground", "selection_background"] + \
           [f"color{i}" for i in range(16)]


def map_palette(colors: dict) -> dict[str, str]:
    """Omarchy colors.toml -> our 22-key palette.

    Two dialects exist: basecamp built-ins use named colors (red, bright_*,
    muted...); aether-generated community themes use a flat schema that is
    already our exact key set - those pass through with validation only.
    """
    if "color0" in colors:
        missing = [k for k in OUR_KEYS if k not in colors]
        if missing:
            die(f"theme uses the flat palette format but is missing: "
                f"{', '.join(missing)}")
        return validate({k: str(colors[k]) for k in OUR_KEYS})
    fg = pick(colors, "bright_foreground", "light_foreground", "foreground",
              required=True, label="foreground")
    out = {
        "accent": pick(colors, "accent", "blue", required=True, label="accent"),
        "cursor": fg,
        "foreground": fg,
        "background": pick(colors, "background", required=True, label="background"),
        "selection_foreground": fg,
        "selection_background": pick(colors, "selection", "muted", "lighter_background",
                                     required=True, label="selection"),
        "color0": pick(colors, "dark_background", "darker_background", "background",
                       required=True, label="color0"),
        "color7": pick(colors, "foreground", "light_foreground",
                       required=True, label="color7"),
        "color8": pick(colors, "muted", "dark_foreground", "selection",
                       required=True, label="color8"),
        "color15": fg,
    }
    ansi = ["red", "green", "yellow", "blue", "magenta", "cyan"]
    for i, name in enumerate(ansi, start=1):
        out[f"color{i}"] = pick(colors, name, required=True, label=name)
        out[f"color{i + 8}"] = pick(colors, f"bright_{name}", name,
                                    required=True, label=f"bright_{name}")
    return validate(out)


def validate(palette: dict[str, str]) -> dict[str, str]:
    hexre = re.compile(r"^#[0-9A-Fa-f]{6}$")
    bad = [k for k, v in palette.items() if not hexre.match(str(v))]
    if bad:
        die(f"non-hex color values after mapping: {', '.join(bad)}")
    return {k: v.lower() for k, v in palette.items()}


def resolve_repo_from_page(url: str) -> str:
    req = urllib.request.Request(
        url, headers={"User-Agent": "Mozilla/5.0 (X11; Linux x86_64) omarchy-import"}
    )
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            html = resp.read().decode(errors="replace")
    except urllib.error.HTTPError as e:
        die(f"could not fetch {url} (HTTP {e.code}) - the site may be "
            "blocking non-browser requests; paste the theme's git repository "
            "URL directly instead")
    m = re.search(r"https://(?:github\.com|codeberg\.org|gitlab\.com)/[\w.-]+/[\w.-]+", html)
    if not m:
        die(f"no git repository link found on {url}")
    repo = m.group(0).removesuffix(".git")
    print(f"Resolved theme repository: {repo}")
    return repo


def load_builtin(name: str) -> tuple[dict, str, "BackgroundSource", str]:
    themes = list_builtin()
    if name not in themes:
        die(f"'{name}' is not a built-in Omarchy theme.\n"
            f"Available: {', '.join(themes)}")
    raw = gh_api(f"repos/{UPSTREAM}/contents/themes/{name}/colors.toml", raw=True)
    colors = tomllib.loads(raw.decode())
    source = f"https://github.com/{UPSTREAM} (MIT), theme '{name}'"

    def fetch_background(dest_dir: Path, slug: str, all_of_them: bool) -> list[Path]:
        try:
            entries = json.loads(gh_api(f"repos/{UPSTREAM}/contents/themes/{name}/backgrounds"))
        except SystemExit:
            return []
        candidates = sorted(
            (e for e in entries
             if e["type"] == "file"
             and Path(e["name"]).suffix.lower() in IMAGE_EXT
             and e["size"] >= MIN_BACKGROUND_BYTES),
            key=lambda e: e["name"],
        )
        if not all_of_them:
            candidates = candidates[:1]
        fetched = []
        for chosen in candidates:
            dest = dest_dir / f"{slug}-{chosen['name']}"
            if not dest.exists():
                data = gh_api(
                    f"repos/{UPSTREAM}/contents/themes/{name}/backgrounds/{chosen['name']}",
                    raw=True)
                dest.write_bytes(data)
            fetched.append(dest)
        return fetched

    return colors, name, fetch_background, source


def load_repo(url: str) -> tuple[dict, str, "BackgroundSource", str]:
    tmp = tempfile.mkdtemp(prefix="omarchy-import.")
    result = subprocess.run(
        ["git", "clone", "--depth", "1", "--quiet", url, tmp],
        capture_output=True, text=True,
    )
    if result.returncode != 0:
        die(f"git clone failed: {result.stderr.strip()}")
    root = Path(tmp)
    colors_file = root / "colors.toml"
    if not colors_file.is_file():
        die(f"no colors.toml at the root of {url} - not an Omarchy theme repo?")
    colors = tomllib.loads(colors_file.read_text())
    repo_name = url.rstrip("/").rsplit("/", 1)[-1].removesuffix(".git")
    name = re.sub(r"^omarchy-|-theme$", "", repo_name) or repo_name
    source = url

    def fetch_background(dest_dir: Path, slug: str, all_of_them: bool) -> list[Path]:
        bg_dir = root / "backgrounds"
        if not bg_dir.is_dir():
            return []
        candidates = sorted(
            p for p in bg_dir.iterdir()
            if p.is_file() and p.suffix.lower() in IMAGE_EXT
            and p.stat().st_size >= MIN_BACKGROUND_BYTES
        )
        if not all_of_them:
            candidates = candidates[:1]
        fetched = []
        for src in candidates:
            dest = dest_dir / f"{slug}-{src.name}"
            if not dest.exists():
                dest.write_bytes(src.read_bytes())
            fetched.append(dest)
        return fetched

    return colors, name, fetch_background, source


def main() -> None:
    parser = argparse.ArgumentParser(
        prog="omarchy-import",
        description="Import an Omarchy theme (built-in name, git URL, or "
                    "omarchythemes.com page) as a palette.",
    )
    parser.add_argument("theme", nargs="?", help="theme name or URL")
    parser.add_argument("--list", action="store_true", help="list built-in themes")
    parser.add_argument("--apply", action="store_true", help="theme-set after import")
    parser.add_argument("--no-wallpaper", action="store_true",
                        help="skip downloading the theme background")
    parser.add_argument("--all-wallpapers", action="store_true",
                        help="download every background the theme ships "
                             "(first one becomes the palette wallpaper; the "
                             "rest are available via SUPER+W)")
    parser.add_argument("--force", action="store_true",
                        help="overwrite an existing palette of the same name")
    parser.add_argument("--dry-run", action="store_true",
                        help="print the palette instead of writing anything")
    args = parser.parse_args()

    if args.list:
        print("\n".join(list_builtin()))
        return
    if not args.theme:
        parser.error("provide a theme name/URL or use --list")

    ref = args.theme
    if "omarchythemes.com" in ref:
        ref = resolve_repo_from_page(ref)
    if ref.startswith(("http://", "https://", "git@")):
        colors, name, fetch_background, source = load_repo(ref)
    else:
        colors, name, fetch_background, source = load_builtin(ref)

    if colors.get("mode") == "light":
        print("warning: this is a light theme; the rest of the stack is "
              "dark-assumed and untested in light mode", file=sys.stderr)

    palette = map_palette(colors)
    slug = re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")
    target = PALETTES_DIR / f"{slug}.toml"

    lines = [f"# {name} - imported from Omarchy: {source}", ""]
    for k in ["accent", "cursor", "foreground", "background",
              "selection_foreground", "selection_background"]:
        lines.append(f'{k} = "{palette[k]}"')
    lines.append("")
    lines += [f'color{i} = "{palette[f"color{i}"]}"' for i in range(16)]

    if args.dry_run:
        print("\n".join(lines))
        print(f"\n(dry run: would write {target}"
              f"{'' if args.no_wallpaper else ' and download the background'})")
        return

    if target.exists() and not args.force:
        die(f"palette '{slug}' already exists - use --force to overwrite")

    wallpapers = []
    if not args.no_wallpaper:
        WALLPAPER_DIR.mkdir(parents=True, exist_ok=True)
        wallpapers = fetch_background(WALLPAPER_DIR, slug, args.all_wallpapers)
        if not wallpapers:
            print("note: theme ships no usable background image; no wallpaper set")

    if wallpapers:
        stored = str(wallpapers[0])
        home = str(Path.home())
        if stored.startswith(home):
            stored = "~" + stored[len(home):]
        lines += ["", f'wallpaper = "{stored}"']
        names = ", ".join(w.name for w in wallpapers)
        print(f"Background{'s' if len(wallpapers) > 1 else ''}: {names}")

    target.write_text("\n".join(lines) + "\n")
    print(f"Palette written: palettes/{slug}.toml")

    if args.apply:
        subprocess.run([str(THEMES_DIR / "bin" / "theme-set"), slug], check=True)
    else:
        print(f"Apply it with: theme-set {slug}")


if __name__ == "__main__":
    main()
