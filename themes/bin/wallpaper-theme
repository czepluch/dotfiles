#!/usr/bin/env python3
# wallpaper-theme - Derive a full palette from a wallpaper and apply it.
#
# A palette producer, symmetric with theme-import: extracts colors with
# wallust (ansidark16 palette + lchansi colorspace = tty-like semantic color
# order with image-derived tinting), writes palettes/wallpaper-<slug>.toml
# (gitignored - promote a keeper by renaming it), and applies it with
# theme-set. The theme engine itself is untouched.
#
# Usage:
#   wallpaper-theme <image>              Derive a palette and apply it
#   wallpaper-theme --browse             Pick the image in the yazi browser
#   wallpaper-theme --no-apply <image>   Only write the palette file
#
# Derived keys beyond wallust's 19: accent = color4 (same convention as
# theme-import), selection_foreground = background, selection_background =
# cursor (same shape as the curated palettes).

import argparse
import json
import re
import subprocess
import sys
import tempfile
from pathlib import Path

THEMES_DIR = Path(__file__).resolve().parent.parent
PALETTES_DIR = THEMES_DIR / "palettes"
WALLPAPER_DIR = Path.home() / "pics" / "wallpapers"

HEX = re.compile(r"^#[0-9A-Fa-f]{6}$")
WALLUST_KEYS = ["background", "foreground", "cursor"] + [f"color{i}" for i in range(16)]


def die(msg: str) -> None:
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(1)


def browse() -> Path | None:
    """Pick an image via the floating yazi browser (same flow as theme-wallpaper)."""
    if not WALLPAPER_DIR.is_dir():
        die(f"{WALLPAPER_DIR} does not exist")
    with tempfile.NamedTemporaryFile(prefix="wallpaper-theme.", delete=False) as f:
        chooser = Path(f.name)
    try:
        subprocess.run(
            ["ghostty", "--class=wallpaper.browser", "-e",
             "yazi", str(WALLPAPER_DIR), f"--chooser-file={chooser}"],
            check=False,
        )
        picked = chooser.read_text().strip().splitlines()
        return Path(picked[0]) if picked else None
    finally:
        chooser.unlink(missing_ok=True)


def extract(image: Path) -> dict[str, str]:
    """Run wallust and return its 19-key scheme (bg/fg/cursor/color0-15)."""
    with tempfile.TemporaryDirectory(prefix="wallpaper-theme.") as tmp:
        (Path(tmp) / "colorschemes").mkdir()
        result = subprocess.run(
            ["wallust", "run", "-d", tmp, "-s", "-T", "-q", "--save-scheme",
             "-p", "ansidark16", "-c", "lchansi", str(image)],
            capture_output=True, text=True,
        )
        if result.returncode != 0:
            hint = result.stderr.strip() or result.stdout.strip()
            die(f"wallust failed: {hint}\n"
                "(near-monochrome images can defeat color extraction)")
        schemes = list((Path(tmp) / "colorschemes").glob("*.json"))
        if not schemes:
            die("wallust reported success but wrote no scheme file")
        scheme = json.loads(schemes[0].read_text())
    missing = [k for k in WALLUST_KEYS if k not in scheme]
    if missing:
        die(f"wallust scheme is missing keys: {', '.join(missing)}")
    bad = [k for k in WALLUST_KEYS if not HEX.match(scheme[k])]
    if bad:
        die(f"wallust scheme has malformed colors: {', '.join(bad)}")
    return {k: scheme[k].lower() for k in WALLUST_KEYS}


def write_palette(image: Path, scheme: dict[str, str]) -> str:
    slug = re.sub(r"[^a-z0-9]+", "-", image.stem.lower()).strip("-")
    if not slug:
        die(f"cannot derive a palette name from {image.name}")
    name = f"wallpaper-{slug}"

    stored = str(image)
    home = str(Path.home())
    if stored.startswith(home):
        stored = "~" + stored[len(home):]

    lines = [
        f"# Generated by wallpaper-theme from {image.name}",
        "# (wallust: ansidark16 palette, lchansi colorspace)",
        "",
        f'accent = "{scheme["color4"]}"',
        f'cursor = "{scheme["cursor"]}"',
        f'foreground = "{scheme["foreground"]}"',
        f'background = "{scheme["background"]}"',
        f'selection_foreground = "{scheme["background"]}"',
        f'selection_background = "{scheme["cursor"]}"',
        "",
    ]
    lines += [f'color{i} = "{scheme[f"color{i}"]}"' for i in range(16)]
    lines += ["", f'wallpaper = "{stored}"', ""]

    (PALETTES_DIR / f"{name}.toml").write_text("\n".join(lines))
    return name


def main() -> None:
    parser = argparse.ArgumentParser(
        prog="wallpaper-theme",
        description="Derive a full color palette from a wallpaper and apply it.",
    )
    parser.add_argument("image", nargs="?", help="path to the wallpaper image")
    parser.add_argument("--browse", action="store_true",
                        help="pick the image in the yazi browser first")
    parser.add_argument("--no-apply", action="store_true",
                        help="write the palette file but do not theme-set it")
    args = parser.parse_args()

    if args.image:
        image = Path(args.image).expanduser().resolve()
    elif args.browse:
        picked = browse()
        if picked is None:
            sys.exit(0)
        image = picked.resolve()
    else:
        parser.error("provide an image path or use --browse")

    if not image.is_file():
        die(f"no such image: {image}")

    scheme = extract(image)
    name = write_palette(image, scheme)
    print(f"Palette written: palettes/{name}.toml")

    if args.no_apply:
        print(f"Apply it with: theme-set {name}")
        return

    subprocess.run([str(THEMES_DIR / "bin" / "theme-set"), name], check=True)


if __name__ == "__main__":
    main()
