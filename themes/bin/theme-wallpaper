#!/usr/bin/env bash
#
# theme-wallpaper - Switch the wallpaper (fuzzel picker or direct path)
#
set -euo pipefail

THEMES_DIR="$(cd "$(dirname "$0")/.." && pwd)"
PALETTES_DIR="$THEMES_DIR/palettes"
COLORS_FILE="$THEMES_DIR/colors.toml"
WALLPAPER_DIR="$HOME/pics/wallpapers"
HYPRPAPER_CONF="$HOME/.config/themes/current/hyprpaper.conf"

usage() {
    cat <<'EOF'
Usage: theme-wallpaper [--browse] [--save] [<path>]

Switch the wallpaper. With no <path>, opens a fuzzel picker over
~/pics/wallpapers/. Applies instantly via hyprctl IPC and persists to the
generated hyprpaper.conf, so it survives logins without touching git.

The quick switch lasts until the next `theme-set` of a palette that
declares its own wallpaper.

Options:
  --browse      Visual picker: floating yazi window with image previews
                (bound to SUPER+W). Enter applies, q cancels.
  --save        Also write the wallpaper into the active palette file,
                making it that theme's permanent wallpaper. This edits the
                git-tracked palettes/<active>.toml - commit it deliberately.
  -h, --help    Show this help message
EOF
}

save_to_palette() {
    local stored="$1" active=""

    for f in "$PALETTES_DIR"/*.toml; do
        if diff -q "$f" "$COLORS_FILE" &>/dev/null; then
            active="$f"
            break
        fi
    done

    if [[ -z "$active" ]]; then
        echo "warning: colors.toml matches no palette - nothing saved" >&2
        return 0
    fi

    # Update the palette and colors.toml identically so the byte-diff
    # (active) detection in theme-set keeps working
    local target
    for target in "$active" "$COLORS_FILE"; do
        if rg -q '^[[:space:]]*wallpaper[[:space:]]*=' "$target"; then
            sed -i "s|^\([[:space:]]*wallpaper[[:space:]]*=[[:space:]]*\).*|\1\"$stored\"|" "$target"
        else
            printf '\nwallpaper = "%s"\n' "$stored" >> "$target"
        fi
    done
    echo "Saved as the wallpaper of $(basename "$active" .toml) (tracked edit - commit when ready)."
}

SAVE=0
BROWSE=0
WALLPAPER=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        --save) SAVE=1; shift ;;
        --browse) BROWSE=1; shift ;;
        -*)
            echo "error: unknown option '$1'" >&2
            echo "Run 'theme-wallpaper --help' for usage." >&2
            exit 1
            ;;
        *) WALLPAPER="$1"; shift ;;
    esac
done

# Visual picker: floating yazi (window rule floats/centers the class) writes
# the chosen file to a chooser file on open; quitting without opening cancels
if [[ $BROWSE -eq 1 && -z "$WALLPAPER" ]]; then
    if [[ ! -d "$WALLPAPER_DIR" ]]; then
        echo "error: $WALLPAPER_DIR does not exist" >&2
        exit 1
    fi
    chooser="$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/wallpaper-pick.XXXXXX")"
    ghostty --class=wallpaper.browser -e yazi "$WALLPAPER_DIR" --chooser-file="$chooser" || true
    if [[ ! -s "$chooser" ]]; then
        rm -f "$chooser"
        exit 0
    fi
    WALLPAPER="$(head -n1 "$chooser")"
    rm -f "$chooser"
fi

# No path given: fuzzel picker over the wallpaper directory
if [[ -z "$WALLPAPER" ]]; then
    if [[ ! -d "$WALLPAPER_DIR" ]]; then
        echo "error: $WALLPAPER_DIR does not exist" >&2
        exit 1
    fi
    shopt -s nullglob nocaseglob
    files=("$WALLPAPER_DIR"/*.{jpg,jpeg,png,webp})
    shopt -u nullglob nocaseglob
    if [[ ${#files[@]} -eq 0 ]]; then
        echo "error: no images in $WALLPAPER_DIR" >&2
        exit 1
    fi
    choice="$(printf '%s\n' "${files[@]##*/}" | sort | fuzzel --dmenu --prompt "wallpaper: ")" || exit 0
    [[ -z "$choice" ]] && exit 0
    WALLPAPER="$WALLPAPER_DIR/$choice"
fi

expanded="${WALLPAPER/#\~/$HOME}"
if [[ ! -f "$expanded" ]]; then
    echo "warning: wallpaper not found: $WALLPAPER" >&2
    exit 1
fi

# Store with ~ instead of the absolute home prefix (portable across machines)
stored="${expanded/#$HOME/\~}"

# Apply instantly via hyprctl IPC (requires hyprpaper > 0.8.3)
if command -v hyprctl &>/dev/null; then
    monitors="$(hyprctl monitors -j 2>/dev/null | jq -r '.[].name' 2>/dev/null)"
    while IFS= read -r monitor; do
        [[ -z "$monitor" ]] && continue
        hyprctl hyprpaper wallpaper "$monitor, $expanded" 2>/dev/null
    done <<< "$monitors"
fi

# Persist for the next login. The stowed ~/.config/hypr/hyprpaper.conf is a
# symlink to this generated file; the empty monitor field matches every
# output, so one block covers laptop and docks alike.
cat > "$HYPRPAPER_CONF" <<EOF
# generated by theme-wallpaper - wallpaper persistence

wallpaper {
    monitor =
    path = $stored
}

splash = false
EOF

echo "Wallpaper: $stored"

[[ $SAVE -eq 1 ]] && save_to_palette "$stored"

exit 0
