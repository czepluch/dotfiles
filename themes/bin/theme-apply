#!/usr/bin/env bash
#
# theme-apply - Render the active palette via matugen
#
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: theme-apply

Render all templates using the current colors.toml palette. This is the
engine behind theme-set - you rarely need to run it directly.

Options:
  -h, --help    Show this help message

Examples:
  theme-apply                   Apply current palette to all templates
  theme-set catppuccin-mocha    (preferred) Set palette and apply in one step

What it does:
  1. Reads colors.toml (defaults to catppuccin-mocha if missing)
  2. bin/palette-to-json converts it to palette.json, deriving the
     aliases (red=color1 ...), gradient1-9, and <key>_vivid variants
  3. matugen renders every templates/*.tera into a staging dir
  4. Each rendered file is moved atomically into ~/.config/themes/current/

A failed render (bad template, missing key) aborts before the move:
the currently applied theme is never left half-updated.

Template variable formats (Tera; see matugen.toml for the file list):
  {{ colors.accent.default.hex }}           #89b4fa
  {{ colors.accent.default.hex_stripped }}  89b4fa
  {{ colors.accent.default.red }}           137   (also .green, .blue)
  {{ colors.accent_vivid.default.hex }}     saturation-boosted variant
EOF
}

case "${1:-}" in
    -h|--help) usage; exit 0 ;;
    "") ;;
    *)
        echo "error: unknown option '$1'" >&2
        echo "Run 'theme-apply --help' for usage." >&2
        exit 1
        ;;
esac

THEMES_DIR="$(cd "$(dirname "$0")/.." && pwd)"
COLORS_FILE="$THEMES_DIR/colors.toml"
OUTPUT_DIR="$HOME/.config/themes/current"
STAGING_DIR="$HOME/.config/themes/.staging"

if ! command -v matugen &>/dev/null; then
    echo "error: matugen not found (install with: paru -S matugen)" >&2
    exit 1
fi

# Bootstrap: default palette on a fresh clone
if [[ ! -f "$COLORS_FILE" ]]; then
    echo "No colors.toml found - defaulting to catppuccin-mocha."
    cp "$THEMES_DIR/palettes/catppuccin-mocha.toml" "$COLORS_FILE"
fi

mkdir -p "$OUTPUT_DIR"
rm -rf "$STAGING_DIR"
mkdir -p "$STAGING_DIR"

"$THEMES_DIR/bin/palette-to-json" "$COLORS_FILE" "$OUTPUT_DIR/palette.json"

# Render everything into staging. matugen is all-or-nothing on errors, and
# set -e aborts here before the move: current/ stays untouched on failure.
(cd "$THEMES_DIR" && matugen --config matugen.toml json "$OUTPUT_DIR/palette.json")

# Atomic per-file swap: staging and current sit on the same filesystem, so
# each mv is a rename(2) - no consumer ever sees a half-written file.
for staged in "$STAGING_DIR"/*; do
    mv -f "$staged" "$OUTPUT_DIR/$(basename "$staged")"
done
rmdir "$STAGING_DIR"

# Fresh-clone safety: the hyprpaper.conf symlink in the hypr stow package
# must never dangle. theme-set overwrites this when a palette has a wallpaper.
if [[ ! -f "$OUTPUT_DIR/hyprpaper.conf" ]]; then
    printf '# generated by theme-set - no wallpaper applied yet\nsplash = false\n' \
        > "$OUTPUT_DIR/hyprpaper.conf"
fi

echo "Theme applied. Output: $OUTPUT_DIR"
