-- Hyprland theme colors - generated by theme-apply into
-- ~/.config/themes/current/hypr-colors.lua and loaded by hyprland.lua (via dofile).
return {
  active_border   = { "rgb({{ colors.cyan_vivid.default.hex_stripped }})", "rgb({{ colors.accent_vivid.default.hex_stripped }})", "rgb({{ colors.magenta_vivid.default.hex_stripped }})" },
  active_angle    = 90,
  inactive_border = "rgba({{ colors.color8.default.hex_stripped }}55)",
}
