/* GTK 3 and 4 colors from the active palette, generated by theme-apply.
   Names follow libadwaita, which adw-gtk3 uses as well. */

@define-color accent_bg_color                  {{ colors.accent_readable.default.hex }};
@define-color accent_fg_color                  {{ colors.on_accent_readable.default.hex }};
@define-color accent_color                     {{ colors.accent_readable.default.hex }};

@define-color destructive_bg_color             {{ colors.red.default.hex }};
@define-color destructive_fg_color             {{ colors.on_red.default.hex }};
@define-color destructive_color                {{ colors.red_readable.default.hex }};
@define-color error_bg_color                   {{ colors.red.default.hex }};
@define-color error_fg_color                   {{ colors.on_red.default.hex }};
@define-color error_color                      {{ colors.red_readable.default.hex }};
@define-color success_bg_color                 {{ colors.green.default.hex }};
@define-color success_fg_color                 {{ colors.on_green.default.hex }};
@define-color success_color                    {{ colors.green_readable.default.hex }};
@define-color warning_bg_color                 {{ colors.yellow.default.hex }};
@define-color warning_fg_color                 {{ colors.on_yellow.default.hex }};
@define-color warning_color                    {{ colors.yellow_readable.default.hex }};

@define-color window_bg_color                  {{ colors.surface1.default.hex }};
@define-color window_fg_color                  {{ colors.foreground.default.hex }};
@define-color view_bg_color                    {{ colors.background.default.hex }};
@define-color view_fg_color                    {{ colors.foreground.default.hex }};

@define-color headerbar_bg_color               {{ colors.surface3.default.hex }};
@define-color headerbar_fg_color               {{ colors.foreground.default.hex }};
@define-color headerbar_border_color           {{ colors.foreground.default.hex }};
@define-color headerbar_backdrop_color         {{ colors.surface1.default.hex }};

@define-color sidebar_bg_color                 {{ colors.surface3.default.hex }};
@define-color sidebar_fg_color                 {{ colors.foreground.default.hex }};
@define-color sidebar_backdrop_color           {{ colors.surface2.default.hex }};
@define-color secondary_sidebar_bg_color       {{ colors.surface2.default.hex }};
@define-color secondary_sidebar_fg_color       {{ colors.foreground.default.hex }};
@define-color secondary_sidebar_backdrop_color {{ colors.surface2.default.hex }};

@define-color card_bg_color                    {{ colors.surface4.default.hex }};
@define-color card_fg_color                    {{ colors.foreground.default.hex }};
@define-color dialog_bg_color                  {{ colors.surface5.default.hex }};
@define-color dialog_fg_color                  {{ colors.foreground.default.hex }};
@define-color popover_bg_color                 {{ colors.surface5.default.hex }};
@define-color popover_fg_color                 {{ colors.foreground.default.hex }};
@define-color thumbnail_bg_color               {{ colors.surface6.default.hex }};
@define-color thumbnail_fg_color               {{ colors.foreground.default.hex }};
