# Background and foreground colors
background = {{ colors.background.default.hex }}
foreground = {{ colors.foreground.default.hex }}
cursor-color = {{ colors.cursor.default.hex }}
selection-foreground = {{ colors.selection_foreground.default.hex }}
selection-background = {{ colors.selection_background.default.hex }}

# Standard colors
palette = 0={{ colors.color0.default.hex }}
