palette = 3={{ colors.color3.default.hex }}
palette = 4={{ colors.color4.default.hex }}
palette = 5={{ colors.color5.default.hex }}
palette = 6={{ colors.color6.default.hex }}
palette = 7={{ colors.color7.default.hex }}

# Bright colors
palette = 8={{ colors.color8.default.hex }}
palette = 9={{ colors.color9.default.hex }}
palette = 10={{ colors.color10.default.hex }}
palette = 11={{ colors.color11.default.hex }}
palette = 12={{ colors.color12.default.hex }}
palette = 13={{ colors.color13.default.hex }}
palette = 14={{ colors.color14.default.hex }}
