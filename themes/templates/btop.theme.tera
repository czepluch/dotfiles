# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="{{ colors.background.default.hex }}"

# Main text color
theme[main_fg]="{{ colors.foreground.default.hex }}"

# Title color for boxes
theme[title]="{{ colors.magenta.default.hex }}"

# Highlight color for keyboard shortcuts
theme[hi_fg]="{{ colors.cyan.default.hex }}"

# Background color of selected item in processes box
theme[selected_bg]="{{ colors.color8.default.hex }}"

# Foreground color of selected item in processes box
theme[selected_fg]="{{ colors.foreground.default.hex }}"

# Color of inactive/disabled text
theme[inactive_fg]="{{ colors.color8.default.hex }}"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="{{ colors.magenta.default.hex }}"

# Box outline and divider line color
theme[cpu_box]="{{ colors.green.default.hex }}"
theme[mem_box]="{{ colors.green.default.hex }}"
theme[net_box]="{{ colors.green.default.hex }}"
theme[proc_box]="{{ colors.green.default.hex }}"
theme[div_line]="{{ colors.color8.default.hex }}"

# Gradient for all meters and graphs
theme[temp_start]="{{ colors.cyan.default.hex }}"
theme[temp_mid]="{{ colors.blue.default.hex }}"
theme[temp_end]="{{ colors.green.default.hex }}"

theme[cpu_start]="{{ colors.cyan.default.hex }}"
theme[cpu_mid]="{{ colors.blue.default.hex }}"
theme[cpu_end]="{{ colors.green.default.hex }}"

theme[free_start]="{{ colors.blue.default.hex }}"
theme[free_mid]="{{ colors.yellow.default.hex }}"
theme[free_end]="{{ colors.yellow.default.hex }}"

theme[cached_start]="{{ colors.yellow.default.hex }}"
theme[cached_mid]="{{ colors.yellow.default.hex }}"
theme[cached_end]="{{ colors.yellow.default.hex }}"

theme[available_start]="{{ colors.cyan.default.hex }}"
theme[available_mid]="{{ colors.cyan.default.hex }}"
theme[available_end]="{{ colors.cyan.default.hex }}"

theme[used_start]="{{ colors.green.default.hex }}"
theme[used_mid]="{{ colors.green.default.hex }}"
theme[used_end]="{{ colors.green.default.hex }}"

theme[download_start]="{{ colors.yellow.default.hex }}"
theme[download_mid]="{{ colors.cyan.default.hex }}"
theme[download_end]="{{ colors.blue.default.hex }}"

theme[upload_start]="{{ colors.yellow.default.hex }}"
theme[upload_mid]="{{ colors.cyan.default.hex }}"
theme[upload_end]="{{ colors.blue.default.hex }}"
