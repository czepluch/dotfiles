# Qt palette for qt6ct from the active palette, generated by theme-apply.
# Colors are #aarrggbb in QPalette role order: WindowText, Button, Light,
# Midlight, Dark, Mid, Text, BrightText, ButtonText, Base, Window, Shadow,
# Highlight, HighlightedText, Link, LinkVisited, AlternateBase, NoRole,
# ToolTipBase, ToolTipText, PlaceholderText.

[ColorScheme]
active_colors=#ff{{ colors.foreground.default.hex_stripped }}, #ff{{ colors.surface4.default.hex_stripped }}, #ff{{ colors.surface6.default.hex_stripped }}, #ff{{ colors.surface5.default.hex_stripped }}, #ff{{ colors.background.default.hex_stripped }}, #ff{{ colors.surface2.default.hex_stripped }}, #ff{{ colors.foreground.default.hex_stripped }}, #ff{{ colors.foreground.default.hex_stripped }}, #ff{{ colors.foreground.default.hex_stripped }}, #ff{{ colors.background.default.hex_stripped }}, #ff{{ colors.surface1.default.hex_stripped }}, #ff000000, #ff{{ colors.accent_readable.default.hex_stripped }}, #ff{{ colors.on_accent_readable.default.hex_stripped }}, #ff{{ colors.accent_readable.default.hex_stripped }}, #ff{{ colors.magenta.default.hex_stripped }}, #ff{{ colors.surface1.default.hex_stripped }}, #ff000000, #ff{{ colors.surface5.default.hex_stripped }}, #ff{{ colors.foreground.default.hex_stripped }}, #ff{{ colors.tone5.default.hex_stripped }}
disabled_colors=#ff{{ colors.tone4.default.hex_stripped }}, #ff{{ colors.surface4.default.hex_stripped }}, #ff{{ colors.surface6.default.hex_stripped }}, #ff{{ colors.surface5.default.hex_stripped }}, #ff{{ colors.background.default.hex_stripped }}, #ff{{ colors.surface2.default.hex_stripped }}, #ff{{ colors.tone4.default.hex_stripped }}, #ff{{ colors.tone4.default.hex_stripped }}, #ff{{ colors.tone4.default.hex_stripped }}, #ff{{ colors.background.default.hex_stripped }}, #ff{{ colors.surface1.default.hex_stripped }}, #ff000000, #ff{{ colors.surface3.default.hex_stripped }}, #ff{{ colors.tone4.default.hex_stripped }}, #ff{{ colors.tone4.default.hex_stripped }}, #ff{{ colors.tone4.default.hex_stripped }}, #ff{{ colors.surface1.default.hex_stripped }}, #ff000000, #ff{{ colors.surface5.default.hex_stripped }}, #ff{{ colors.tone4.default.hex_stripped }}, #ff{{ colors.tone4.default.hex_stripped }}
inactive_colors=#ff{{ colors.foreground.default.hex_stripped }}, #ff{{ colors.surface4.default.hex_stripped }}, #ff{{ colors.surface6.default.hex_stripped }}, #ff{{ colors.surface5.default.hex_stripped }}, #ff{{ colors.background.default.hex_stripped }}, #ff{{ colors.surface2.default.hex_stripped }}, #ff{{ colors.foreground.default.hex_stripped }}, #ff{{ colors.foreground.default.hex_stripped }}, #ff{{ colors.foreground.default.hex_stripped }}, #ff{{ colors.background.default.hex_stripped }}, #ff{{ colors.surface1.default.hex_stripped }}, #ff000000, #ff{{ colors.accent_readable.default.hex_stripped }}, #ff{{ colors.on_accent_readable.default.hex_stripped }}, #ff{{ colors.accent_readable.default.hex_stripped }}, #ff{{ colors.magenta.default.hex_stripped }}, #ff{{ colors.surface1.default.hex_stripped }}, #ff000000, #ff{{ colors.surface5.default.hex_stripped }}, #ff{{ colors.foreground.default.hex_stripped }}, #ff{{ colors.tone5.default.hex_stripped }}
