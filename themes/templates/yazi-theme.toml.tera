# Yazi theme - generated by theme-apply

[mgr]
cwd = { fg = "{{ colors.blue.default.hex }}" }

# Hovered
hovered = { fg = "{{ colors.background.default.hex }}", bg = "{{ colors.blue.default.hex }}" }
preview_hovered = { underline = true }

# Find
find_keyword = { fg = "{{ colors.yellow.default.hex }}", italic = true }
find_position = { fg = "{{ colors.cyan.default.hex }}", bg = "reset", italic = true }

# Marker
marker_copied = { fg = "{{ colors.green.default.hex }}", bg = "{{ colors.green.default.hex }}" }
marker_cut = { fg = "{{ colors.red.default.hex }}", bg = "{{ colors.red.default.hex }}" }
marker_marked = { fg = "{{ colors.blue.default.hex }}", bg = "{{ colors.blue.default.hex }}" }
marker_selected = { fg = "{{ colors.cyan.default.hex }}", bg = "{{ colors.cyan.default.hex }}" }

# Tab
tab_active = { fg = "{{ colors.background.default.hex }}", bg = "{{ colors.blue.default.hex }}" }
tab_inactive = { fg = "{{ colors.color7.default.hex }}", bg = "{{ colors.background.default.hex }}" }
tab_width = 1

# Count
count_copied = { fg = "{{ colors.background.default.hex }}", bg = "{{ colors.green.default.hex }}" }
count_cut = { fg = "{{ colors.background.default.hex }}", bg = "{{ colors.red.default.hex }}" }
count_selected = { fg = "{{ colors.background.default.hex }}", bg = "{{ colors.cyan.default.hex }}" }

# Border
border_symbol = "|"
border_style = { fg = "{{ colors.blue.default.hex }}" }

# Highlighting
syntect_theme = ""

[mode]
normal_main = { fg = "{{ colors.background.default.hex }}", bg = "{{ colors.green.default.hex }}", bold = true }
normal_alt = { fg = "{{ colors.green.default.hex }}", bg = "{{ colors.color8.default.hex }}" }
select_main = { fg = "{{ colors.background.default.hex }}", bg = "{{ colors.cyan.default.hex }}", bold = true }
select_alt = { fg = "{{ colors.cyan.default.hex }}", bg = "{{ colors.color8.default.hex }}" }
unset_main = { fg = "{{ colors.background.default.hex }}", bg = "{{ colors.magenta.default.hex }}", bold = true }
unset_alt = { fg = "{{ colors.magenta.default.hex }}", bg = "{{ colors.color8.default.hex }}" }

[status]
separator_open = ""
separator_close = ""
separator_style = { fg = "{{ colors.blue.default.hex }}", bg = "{{ colors.blue.default.hex }}" }

# Progress
progress_label = { fg = "{{ colors.color7.default.hex }}", bold = true }
progress_normal = { fg = "{{ colors.green.default.hex }}", bg = "{{ colors.background.default.hex }}" }
progress_error = { fg = "{{ colors.red.default.hex }}", bg = "{{ colors.background.default.hex }}" }

# Permissions
permissions_t = { fg = "{{ colors.green.default.hex }}" }
permissions_r = { fg = "{{ colors.cyan.default.hex }}" }
permissions_w = { fg = "{{ colors.yellow.default.hex }}" }
permissions_x = { fg = "{{ colors.blue.default.hex }}" }
permissions_s = { fg = "{{ colors.color7.default.hex }}" }

[input]
border = { fg = "{{ colors.blue.default.hex }}" }
title = {}
value = {}
selected = { reversed = true }

[completion]
border = { fg = "{{ colors.blue.default.hex }}" }
active = { bg = "{{ colors.blue.default.hex }}", fg = "{{ colors.background.default.hex }}" }
inactive = {}

[tasks]
border = { fg = "{{ colors.blue.default.hex }}" }
title = {}
hovered = { fg = "{{ colors.green.default.hex }}" }

[which]
cols = 3
mask = { bg = "{{ colors.background.default.hex }}" }
cand = { fg = "{{ colors.cyan.default.hex }}" }
rest = { fg = "{{ colors.color7.default.hex }}" }
desc = { fg = "{{ colors.blue.default.hex }}" }
separator = "  "
separator_style = { fg = "{{ colors.blue.default.hex }}" }

[help]
on = { fg = "{{ colors.green.default.hex }}" }
run = { fg = "{{ colors.cyan.default.hex }}" }
desc = { fg = "{{ colors.color7.default.hex }}" }
hovered = { bg = "{{ colors.blue.default.hex }}", bold = true }
footer = { fg = "{{ colors.background.default.hex }}", bg = "{{ colors.color7.default.hex }}" }

# git.yazi status signs in the file list
[git]
unstaged  = { fg = "{{ colors.yellow.default.hex }}" }
staged    = { fg = "{{ colors.green.default.hex }}" }
added     = { fg = "{{ colors.green.default.hex }}" }
untracked = { fg = "{{ colors.magenta.default.hex }}" }
deleted   = { fg = "{{ colors.red.default.hex }}" }
updated   = { fg = "{{ colors.yellow.default.hex }}" }
ignored   = { fg = "{{ colors.color8.default.hex }}" }

[filetype]
rules = [
  # Images
  { mime = "image/*", fg = "{{ colors.cyan.default.hex }}" },

  # Videos
  { mime = "video/*", fg = "{{ colors.magenta.default.hex }}" },
  { mime = "audio/*", fg = "{{ colors.magenta.default.hex }}" },

  # Archives
  { mime = "application/*zip", fg = "{{ colors.red.default.hex }}" },
  { mime = "application/*tar", fg = "{{ colors.red.default.hex }}" },
  { mime = "application/*compressed", fg = "{{ colors.red.default.hex }}" },

  # Documents
  { mime = "application/pdf", fg = "{{ colors.yellow.default.hex }}" },
  { url = "*.md", fg = "{{ colors.blue.default.hex }}" },

  # Code
  { url = "*.{js,ts,jsx,tsx}", fg = "{{ colors.cyan.default.hex }}" },
  { url = "*.{py,pyc}", fg = "{{ colors.green.default.hex }}" },
  { url = "*.{rs,toml}", fg = "{{ colors.red.default.hex }}" },
  { url = "*.{sol,gleam}", fg = "{{ colors.blue.default.hex }}" },

  # Directories
  { url = "*/", fg = "{{ colors.blue.default.hex }}" },

  # Fallback
  { url = "*", fg = "{{ colors.color7.default.hex }}" },
]

[icon]
rules = [
  { url = "*/", text = "" },
  { url = "*.rs", text = "" },
  { url = "*.py", text = "" },
  { url = "*.js", text = "" },
  { url = "*.ts", text = "" },
  { url = "*.sol", text = "󰞻" },
  { url = "*.md", text = "" },
  { url = "*.json", text = "" },
  { url = "*.toml", text = "" },
  { url = "*.yaml", text = "" },
  { url = "*.yml", text = "" },
]
