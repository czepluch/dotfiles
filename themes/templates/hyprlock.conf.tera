$color = rgba({{ colors.background.default.red }}, {{ colors.background.default.green }}, {{ colors.background.default.blue }}, 1)
$inner_color = rgba({{ colors.background.default.red }}, {{ colors.background.default.green }}, {{ colors.background.default.blue }}, 0.66)
$outer_color = rgba({{ colors.magenta.default.red }}, {{ colors.magenta.default.green }}, {{ colors.magenta.default.blue }}, 1)
$font_color = rgba({{ colors.foreground.default.red }}, {{ colors.foreground.default.green }}, {{ colors.foreground.default.blue }}, 1)
$placeholder_color = rgba({{ colors.foreground.default.red }}, {{ colors.foreground.default.green }}, {{ colors.foreground.default.blue }}, 0.7)
$check_color = rgba({{ colors.cyan.default.red }}, {{ colors.cyan.default.green }}, {{ colors.cyan.default.blue }}, 1)

# Palette for the lockscreen body (hyprlock.conf consumes these nine vars)
$accent       = rgba({{ colors.accent.default.red }}, {{ colors.accent.default.green }}, {{ colors.accent.default.blue }}, 1.0)
$accent_dim   = rgba({{ colors.accent.default.red }}, {{ colors.accent.default.green }}, {{ colors.accent.default.blue }}, 0.55)
$accent_glow  = rgba({{ colors.accent.default.red }}, {{ colors.accent.default.green }}, {{ colors.accent.default.blue }}, 0.2)
$fg           = rgba({{ colors.foreground.default.red }}, {{ colors.foreground.default.green }}, {{ colors.foreground.default.blue }}, 1.0)
$fg_dim       = rgba({{ colors.foreground.default.red }}, {{ colors.foreground.default.green }}, {{ colors.foreground.default.blue }}, 0.7)
$fg_dimmer    = rgba({{ colors.foreground.default.red }}, {{ colors.foreground.default.green }}, {{ colors.foreground.default.blue }}, 0.45)
$bg_input     = rgba(0, 0, 0, 0.55)
$chrom_red    = rgba({{ colors.color1.default.red }}, {{ colors.color1.default.green }}, {{ colors.color1.default.blue }}, 0.7)
$chrom_cyan   = rgba({{ colors.cyan.default.red }}, {{ colors.cyan.default.green }}, {{ colors.cyan.default.blue }}, 0.7)

# Pango-safe hex forms for use inside label markup (## = escaped literal #)
$accent_pango = ##{{ colors.accent.default.hex_stripped }}
$red_pango    = ##{{ colors.red.default.hex_stripped }}
