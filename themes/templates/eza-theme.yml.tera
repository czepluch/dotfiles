# eza theme - generated by theme-apply
# Keys not listed here keep eza's built-in style; extension groups map to
# file_type below.

colourful: true

filekinds:
  normal: {foreground: "{{ colors.foreground.default.hex }}"}
  directory: {foreground: "{{ colors.accent.default.hex }}", is_bold: true}
  symlink: {foreground: "{{ colors.cyan.default.hex }}"}
  pipe: {foreground: "{{ colors.yellow.default.hex }}"}
  block_device: {foreground: "{{ colors.red.default.hex }}", is_bold: true}
  char_device: {foreground: "{{ colors.red.default.hex }}", is_bold: true}
  socket: {foreground: "{{ colors.magenta.default.hex }}"}
  special: {foreground: "{{ colors.yellow.default.hex }}"}
  executable: {foreground: "{{ colors.green.default.hex }}", is_bold: true}
  mount_point: {foreground: "{{ colors.blue.default.hex }}", is_underline: true}

perms:
  user_read: {foreground: "{{ colors.yellow.default.hex }}", is_bold: true}
  user_write: {foreground: "{{ colors.red.default.hex }}", is_bold: true}
  user_execute_file: {foreground: "{{ colors.green.default.hex }}", is_bold: true}
  user_execute_other: {foreground: "{{ colors.green.default.hex }}", is_bold: true}
  group_read: {foreground: "{{ colors.yellow.default.hex }}"}
  group_write: {foreground: "{{ colors.red.default.hex }}"}
  group_execute: {foreground: "{{ colors.green.default.hex }}"}
  other_read: {foreground: "{{ colors.yellow.default.hex }}"}
  other_write: {foreground: "{{ colors.red.default.hex }}"}
  other_execute: {foreground: "{{ colors.green.default.hex }}"}
  special_user_file: {foreground: "{{ colors.magenta.default.hex }}"}
  special_other: {foreground: "{{ colors.magenta.default.hex }}"}
  attribute: {foreground: "{{ colors.color8.default.hex }}"}

size:
  major: {foreground: "{{ colors.green.default.hex }}", is_bold: true}
  minor: {foreground: "{{ colors.green.default.hex }}"}
  number_byte: {foreground: "{{ colors.color7.default.hex }}"}
  number_kilo: {foreground: "{{ colors.green.default.hex }}"}
  number_mega: {foreground: "{{ colors.yellow.default.hex }}"}
  number_giga: {foreground: "{{ colors.red.default.hex }}"}
  number_huge: {foreground: "{{ colors.magenta.default.hex }}"}
  unit_byte: {foreground: "{{ colors.color8.default.hex }}"}
  unit_kilo: {foreground: "{{ colors.green.default.hex }}", is_dimmed: true}
  unit_mega: {foreground: "{{ colors.yellow.default.hex }}", is_dimmed: true}
  unit_giga: {foreground: "{{ colors.red.default.hex }}", is_dimmed: true}
  unit_huge: {foreground: "{{ colors.magenta.default.hex }}", is_dimmed: true}

users:
  user_you: {foreground: "{{ colors.yellow.default.hex }}", is_bold: true}
  user_root: {foreground: "{{ colors.red.default.hex }}", is_bold: true}
  user_other: {foreground: "{{ colors.foreground.default.hex }}"}
  group_yours: {foreground: "{{ colors.yellow.default.hex }}"}
  group_other: {foreground: "{{ colors.color8.default.hex }}"}
  group_root: {foreground: "{{ colors.red.default.hex }}"}

links:
  normal: {foreground: "{{ colors.red.default.hex }}", is_bold: true}
  multi_link_file: {foreground: "{{ colors.red.default.hex }}"}

git:
  new: {foreground: "{{ colors.green.default.hex }}"}
  modified: {foreground: "{{ colors.yellow.default.hex }}"}
  deleted: {foreground: "{{ colors.red.default.hex }}"}
  renamed: {foreground: "{{ colors.blue.default.hex }}"}
  ignored: {foreground: "{{ colors.color8.default.hex }}"}
  conflicted: {foreground: "{{ colors.red.default.hex }}", is_bold: true}

git_repo:
  branch_main: {foreground: "{{ colors.green.default.hex }}"}
  branch_other: {foreground: "{{ colors.yellow.default.hex }}"}
  git_clean: {foreground: "{{ colors.green.default.hex }}"}
  git_dirty: {foreground: "{{ colors.yellow.default.hex }}"}

file_type:
  image: {foreground: "{{ colors.magenta.default.hex }}"}
  video: {foreground: "{{ colors.magenta.default.hex }}", is_bold: true}
  music: {foreground: "{{ colors.cyan.default.hex }}"}
  crypto: {foreground: "{{ colors.green.default.hex }}"}
  document: {foreground: "{{ colors.foreground.default.hex }}"}
  compressed: {foreground: "{{ colors.red.default.hex }}"}
  temp: {foreground: "{{ colors.color8.default.hex }}", is_dimmed: true}
  compiled: {foreground: "{{ colors.yellow.default.hex }}"}
  build: {foreground: "{{ colors.yellow.default.hex }}", is_bold: true}
  source: {foreground: "{{ colors.blue.default.hex }}"}

punctuation: {foreground: "{{ colors.color8.default.hex }}"}
date: {foreground: "{{ colors.cyan.default.hex }}"}
inode: {foreground: "{{ colors.magenta.default.hex }}"}
blocks: {foreground: "{{ colors.cyan.default.hex }}"}
header: {foreground: "{{ colors.foreground.default.hex }}", is_underline: true}
octal: {foreground: "{{ colors.magenta.default.hex }}"}
control_char: {foreground: "{{ colors.red.default.hex }}"}
broken_symlink: {foreground: "{{ colors.red.default.hex }}"}
broken_path_overlay: {foreground: "{{ colors.red.default.hex }}", is_underline: true}
