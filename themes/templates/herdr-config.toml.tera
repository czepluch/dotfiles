# herdr configuration - generated by theme-apply
# Edit themes/templates/herdr-config.toml.tera, then run theme-apply and
# `herdr server reload-config`. Changes made in herdr's settings menu land in
# the generated file and are overwritten by the next theme-apply.
# All options with their defaults: herdr --default-config

onboarding = false

[theme]
# Base theme for every token not overridden in [theme.custom]. "terminal"
# draws with the host terminal's ANSI palette.
name = "terminal"

# Color names are not validated: an unknown name renders as cyan and
# `herdr config check` still passes. Use hex values.
# sidebar_bg, active_row_bg, and selection_bg need herdr 0.9 or newer.
[theme.custom]
# Active pane border, active tab, selected menu row, mode badge, key hints,
# modal borders
accent = "{{ colors.accent.default.hex }}"
# Modal and status bar background, and the text drawn on top of accent
panel_bg = "{{ colors.background.default.hex }}"
# Sidebar background. Set explicitly so the terminal's background opacity
# does not apply to it.
sidebar_bg = "{{ colors.background.default.hex }}"
# Focused sidebar row
active_row_bg = "{{ colors.tone1.default.hex }}"
# Navigate-mode cursor row
selection_bg = "{{ colors.tone2.default.hex }}"
# Sidebar dividers
surface_dim = "{{ colors.tone1.default.hex }}"
# Inactive tabs, secondary buttons, modal separators
surface0 = "{{ colors.tone1.default.hex }}"
surface1 = "{{ colors.tone3.default.hex }}"
# Sidebar labels, inactive tab labels, inactive pane borders, hints
overlay0 = "{{ colors.tone6.default.hex }}"
# Secondary text, scrollbar thumb
overlay1 = "{{ colors.tone7.default.hex }}"
# List items, agent workspace names
subtext0 = "{{ colors.tone8.default.hex }}"
text = "{{ colors.foreground.default.hex }}"
# Key names in the keybinds menu, branch names
mauve = "{{ colors.magenta.default.hex }}"
# Agent state: idle
green = "{{ colors.green.default.hex }}"
# Agent state: working
yellow = "{{ colors.yellow.default.hex }}"
# Agent state: blocked
red = "{{ colors.red.default.hex }}"
blue = "{{ colors.blue.default.hex }}"
teal = "{{ colors.cyan.default.hex }}"
peach = "{{ colors.bright_yellow.default.hex }}"

[keys]
# Press twice to send a literal ctrl+space to the pane.
prefix = "ctrl+space"
# Jump between panes that run an agent, across workspaces
next_agent = "prefix+a"
previous_agent = "prefix+shift+a"
# Toggle between the two most recently focused panes
last_pane = "prefix+space"

# Opens in the focused pane's working directory
[[keys.command]]
key = "prefix+y"
type = "popup"
command = "lazygit"
description = "lazygit"
width = "90%"
height = "90%"

[ui]
agent_panel_sort = "spaces"
show_agent_labels_on_pane_borders = true
hide_tab_bar_when_single_tab = true

# Claude rows add the session title between the location and the agent name
[ui.sidebar.agents.rows_by_agent]
claude = [["state_icon", "workspace", "tab"], ["terminal_title_stripped"], ["agent"]]

[ui.toast]
delivery = "system"
