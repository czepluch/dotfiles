/* Theme color palette - generated by theme-apply */
@define-color bg             {{ colors.background.default.hex }};
@define-color fg             {{ colors.foreground.default.hex }};
@define-color black          {{ colors.color0.default.hex }};
@define-color red            {{ colors.color1.default.hex }};
@define-color green          {{ colors.color2.default.hex }};
@define-color yellow         {{ colors.color3.default.hex }};
@define-color blue           {{ colors.color4.default.hex }};
@define-color magenta        {{ colors.color5.default.hex }};
@define-color cyan           {{ colors.color6.default.hex }};
@define-color white          {{ colors.color7.default.hex }};
@define-color bright-black   {{ colors.color8.default.hex }};
@define-color bright-red     {{ colors.color9.default.hex }};
@define-color bright-green   {{ colors.color10.default.hex }};
@define-color bright-yellow  {{ colors.color11.default.hex }};
@define-color bright-blue    {{ colors.color12.default.hex }};
@define-color bright-magenta {{ colors.color13.default.hex }};
@define-color bright-cyan    {{ colors.color14.default.hex }};
@define-color bright-white   {{ colors.color15.default.hex }};
