#!/bin/bash
# Convert an SVG or PNG logo into braille or block-character text art.
#
# Usage: logo-to-text <image.svg|png> <output.txt> [options]
#   -w, --width <columns>       Maximum width in terminal columns (default: 80)
#   -H, --height <rows>         Maximum height in terminal rows (default: 26)
#   -m, --mode <braille|block>  Character set (default: braille)
#   -t, --threshold <percent>   Pixel cutoff 0-100 (default: 50)
#       --invert                Treat light pixels as the logo instead of dark pixels
#
# Braille cells hold 2x4 dots, block cells hold 1x2 pixels, so the image is
# rasterised at that many pixels per cell, thresholded to 1-bit, then packed.
# Images with transparency use the alpha channel as the shape, so fill colour
# does not matter; opaque images are converted to grayscale instead.
set -euo pipefail

usage() { sed -n '4,9p' "$0" | sed 's/^# \{0,1\}//'; }

width=80 height=26 mode=braille threshold=50 invert=false
input="" output=""

while (($# > 0)); do
  case "$1" in
  -w | --width) width=$2; shift ;;
  -H | --height) height=$2; shift ;;
  -m | --mode) mode=$2; shift ;;
  -t | --threshold) threshold=$2; shift ;;
  --invert) invert=true ;;
  -h | --help) usage; exit 0 ;;
  -*) echo "Unknown option: $1" >&2; usage >&2; exit 1 ;;
  *)
    if [[ -z $input ]]; then input=$1
    elif [[ -z $output ]]; then output=$1
    else echo "Unexpected argument: $1" >&2; exit 1
    fi
    ;;
  esac
  shift
done

[[ -n $input && -n $output ]] || { usage >&2; exit 1; }
[[ -f $input ]] || { echo "No such file: $input" >&2; exit 1; }
[[ $mode == braille || $mode == block ]] || { echo "Invalid mode: $mode" >&2; exit 1; }

if [[ $mode == braille ]]; then
  pixel_width=$((width * 2)) pixel_height=$((height * 4))
else
  pixel_width=$width pixel_height=$((height * 2))
fi

# Render vectors at high density so the downscale has something to sample.
read_args=(-background none -density 300 "$input" -auto-orient)

alpha_range=$(magick "${read_args[@]}" -alpha extract -format '%[fx:minima] %[fx:maxima]' info:)
read -r alpha_min alpha_max <<<"$alpha_range"

if awk -v min="$alpha_min" -v max="$alpha_max" 'BEGIN { exit !(min < 0.999 && max > min) }'; then
  shape_args=(-alpha extract -alpha off)
  [[ $invert == true ]] && shape_args+=(-negate)
else
  shape_args=(-alpha remove -alpha off -colorspace Gray)
  [[ $invert == false ]] && shape_args+=(-negate)
fi

# The 1px black border lets -trim crop to the logo's bounding box.
# The final -negate makes logo pixels "1" in the PBM (PBM treats 1 as black).
magick "${read_args[@]}" "${shape_args[@]}" \
  -bordercolor black -border 1 -trim +repage \
  -resize "${pixel_width}x${pixel_height}" -threshold "${threshold}%" \
  -negate -compress none pbm:- |
  awk -v mode="$mode" '
    BEGIN {
      dot[0,0] = 1;  dot[0,1] = 2;  dot[0,2] = 4;  dot[0,3] = 64
      dot[1,0] = 8;  dot[1,1] = 16; dot[1,2] = 32; dot[1,3] = 128
      block["11"] = "█"; block["10"] = "▀"; block["01"] = "▄"; block["00"] = " "
    }
    { sub(/#.*/, ""); for (i = 1; i <= NF; i++) tok[++n] = $i }
    END {
      if (tok[1] != "P1") exit 1
      w = tok[2]; h = tok[3]; off = 4
      step = (mode == "braille") ? 4 : 2
      for (y = 0; y < h; y += step) {
        line = ""
        if (mode == "braille") {
          for (x = 0; x < w; x += 2) {
            code = 0
            for (dy = 0; dy < 4; dy++)
              for (dx = 0; dx < 2; dx++)
                if (y + dy < h && x + dx < w && tok[off + (y + dy) * w + x + dx] == 1)
                  code += dot[dx, dy]
            line = line (code ? sprintf("%c", 10240 + code) : " ")
          }
        } else {
          for (x = 0; x < w; x++) {
            top = tok[off + y * w + x]
            bottom = (y + 1 < h) ? tok[off + (y + 1) * w + x] : 0
            line = line block[top bottom]
          }
        }
        sub(/ +$/, "", line)
        print line
      }
    }
  ' >"$output"

[[ -s $output ]] || { echo "No logo pixels found in $input" >&2; exit 1; }
echo "Wrote $(wc -l <"$output") lines to $output"
