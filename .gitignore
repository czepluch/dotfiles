# Ignore backup files
*.backup-*

# Ignore OS-specific files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# Ignore editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Ignore any personal override files
*.local
*_local

# But keep the bin stow package, whose layout requires bin/.local/bin/
!bin/.local/
!bin/.local/**

# Ignore AI agent guidance files (private)
AGENTS.md
CLAUDE.md

# Theme system - active palette is a copy of the selected palette file
themes/colors.toml

# Yazi plugins are third-party content installed by `ya pkg install` from the
# tracked package.toml manifest; only our own local plugins are kept in git
yazi/.config/yazi/plugins/*
!yazi/.config/yazi/plugins/folder-rules.yazi/
!yazi/.config/yazi/plugins/folder-rules.yazi/**

# Keep this file
!.gitignore
hypr/.config/hypr/shaders/
