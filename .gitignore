# Ignore backup files
*.backup-*

# Ignore OS-specific files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# Ignore editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Ignore any personal override files
*.local
*_local

# But keep the stow packages whose layout requires <pkg>/.local/bin/
!bin/.local/
!bin/.local/**
!screensaver/.local/
!screensaver/.local/**

# Ignore AI agent guidance files (private)
AGENTS.md
CLAUDE.md

# Theme system - active palette is a copy of the selected palette file
themes/colors.toml

# Theme system - wallpaper-derived palettes are generated output
# (promote a keeper by renaming it to drop the wallpaper- prefix)
themes/palettes/wallpaper-*.toml

# Yazi plugins are third-party content installed by `ya pkg install` from the
# tracked package.toml manifest; only our own local plugins are kept in git
yazi/.config/yazi/plugins/*
!yazi/.config/yazi/plugins/folder-rules.yazi/
!yazi/.config/yazi/plugins/folder-rules.yazi/**

# herdr keeps its sockets, logs, and session state next to config.toml
herdr/.config/herdr/*
!herdr/.config/herdr/config.toml

# Keep this file
!.gitignore
hypr/.config/hypr/shaders/
